# Copy to backup.env (chmod 600). Keep BACKUP_PASSPHRASE somewhere safe outside the
# server too (a password manager): without it the backups can't be opened.
BACKUP_PASSPHRASE=

# Optional, recommended: a copy of every backup goes to a private Telegram chat.
# Create a bot with @BotFather, send it /start, then run ./telegram-chat-id.sh <token>.
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# KEEP_DAYS=14
# BACKUP_DIR=/opt/telenotify/backups
# PG_CONTAINER=telenotify-postgres-1
